<apex:page sidebar="false" renderAs="pdf" controller="InwiB2C_ModificationMdn_Controller" showHeader="false" applyBodyTag="false">

    <head>
        <style>
            body {
                font-family: 'Arial Unicode MS';
                font-size: 12px;
            }

            @page: first {
                size: A4;
                margin-top: 0px margin-right:0px;
                margin-left: 0px;
                margin-bottom: 0cm;
            }

            @page {
                size: A4;
                margin-top: 0px;
                margin-right: 0px;
                margin-left: 0px;
                margin-bottom: 0cm;
            }
        </style>
    </head>

    <body>
        <div style="page-break-after:avoid ; height: 1100px ">
            <img style="width:100%;" src="{!$Resource.InwiB2C_FormulaireChangementMdn}" />
            <!--  -->
                <p style="position: absolute;top:80px;left: 385px;font-size: 14px">{!name}</p>
                <p style="position: absolute;top:105px;left: 385px;font-size: 14px">{!cin}</p>
                <p style="position: absolute;top:130px;left: 385px;font-size: 14px">{!mdn}</p>
