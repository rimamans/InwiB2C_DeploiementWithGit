                <p style="position: absolute;top:290PX;left: 385px;font-size: 14px">{!detailModification}</p>
                <p style="position: absolute;top:412px;left: 520px;font-size: 14px">0 DH</p>
                <p style="position: absolute;top:432px;left: 520px;font-size: 14px">{!IF(AND( fraischgtmdn != 'null'),fraischgtmdn, '0')} DH</p>
                <!-- <p style="position: absolute;top:432px;left: 520px;font-size: 14px">{!fraischgtmdn} DH</p> -->
                <!-- <p style="position: absolute;top:450px;left: 520px;font-size: 14px">{!fraischgtmdn} DH</p> -->
                <p style="position: absolute;top:450px;left: 520px;font-size: 14px">{!IF(AND( fraischgtmdn != 'null'),fraischgtmdn, '0')} DH</p>
                <p style="position: absolute;top:483px;left: 260px;font-size: 14px">{!oldmdn}</p>
                <p style="position: absolute;top:483px;left: 570px;font-size: 14px">{!newmdn}</p>
                <p style="position: absolute;top:510px;left: 520px;font-size: 14px">{!categoriemdn}</p>
                <p style="position: absolute;top:802px;left: 560px;font-size: 14px">{!datedefacturation}</p>
                

        </div>

