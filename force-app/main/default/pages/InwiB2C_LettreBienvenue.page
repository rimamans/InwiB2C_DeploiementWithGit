<apex:page renderAs="pdf" controller="InwiB2C_FormulaireRemb" applyHtmlTag="false" showHeader="false">

    <head>
        <style>
            body {
                font-family: 'Arial Unicode MS';
                font-size: 12px;

            }

            @page {
                size: A4;
                margin: 0px
            }
        </style>
    </head>

    <body>
        <div>
            <img style="width: 100%; height: 100%" src="{!$Resource.InwiB2C_LettreBienvenue}" />
            
              <p style="position: absolute;top: 178px;left: 150px;font-size: 13px">{!IF(contains(keys,'offre'),output['offre'], '')}</p>
              <p style="position: absolute;top: 196px;left: 200px;font-size: 13px">{!IF(contains(keys,'AccountNumber'),output['AccountNumber'], '')}</p>
              <p style="position: absolute;top: 215px;left: 245px;font-size: 13px">{!IF(contains(keys,'email'),output['email'], '')}</p>


        </div>
    </body>
</apex:page>