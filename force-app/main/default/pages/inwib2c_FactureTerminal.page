       <p style="position: absolute;top: {! 469 + (index2 *30) + (loopItem *1119) + added}px;left: 25%;font-size: 9px; width: 130px; word-wrap: break-word;">{!IF(contains(keysTerminal, 'TypeTerminal') && item['TypeTerminal'] != null, item['TypeTerminal'], '')}</p> -->
       <!-- <p style="position: absolute;top: {! 475 + (index2 *30) + (loopItem *1119) + added}px;left: 43%;font-size: 10px">{!IF(contains(keysTerminal, 'ICCSIM') && item['ICCSIM'] != null, item['ICCSIM'], '')}</p> -->
       <div style="position: absolute; top: {! 483 + (index2 *18)}px; left: 10%; font-size: 10px">{!IF(contains(keysTerminal, 'CodeArticleTerminal') && item['CodeArticleTerminal'] != null, item['CodeArticleTerminal'], '')}</div>

