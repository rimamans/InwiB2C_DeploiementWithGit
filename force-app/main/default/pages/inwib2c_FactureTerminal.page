       <div style="position: absolute;top: {! 688 }px;left: 82%;font-size: 12px;font-weight: bold; font-family: 'Helvetica', sans-serif;">{!IF(contains(keys,'montantTotal'),ipOutput['montantTotal'], '')}</div>
       <div style="position: absolute;top: {! 705 }px;left: 82%;font-size: 12px;font-weight: bold; font-family: 'Helvetica', sans-serif;">0.00</div>
